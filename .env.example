# ===== Mercado Livre (API oficial - gratuita) =====
# Crie sua aplicacao em https://developers.mercadolivre.com.br/ (Minhas aplicacoes)
ML_CLIENT_ID=coloque_seu_client_id_aqui
ML_CLIENT_SECRET=coloque_seu_client_secret_aqui

# Sua tag/ID de afiliado do Mercado Livre (aparece no painel de Afiliados)
ML_AFFILIATE_TAG=sua_tag_de_afiliado

# ===== Telegram =====
# Fale com @BotFather no Telegram, crie um bot e cole o token abaixo
TELEGRAM_BOT_TOKEN=coloque_o_token_do_botfather_aqui
# ID ou @usuario do seu canal (ex.: @ofertasgamestech). O bot precisa ser ADMIN do canal.
TELEGRAM_CHANNEL_ID=@seu_canal_aqui

# ===== Regras de negocio =====
# So considera "oferta" se o desconto vs. menor preco recente for pelo menos isso (%)
MIN_DISCOUNT_PERCENT=5
# Janelas de historico usadas nas analises (dias)
HISTORY_WINDOWS=30,60,90

# ===== Fila de postagem =====
CICLO_MIN=10
PAUSA_MADRUGADA=nao
DESCONTO_FORTE_PCT=15
CD_MENOR_PRECO=240
CD_CUPOM=480
CD_DESC_FORTE=720
CD_DESC_LEVE=1440
CD_SEM_DESCONTO=2880
LOGO_PATH=logo.png
TEMPLATE_PATH=template.png
SITE_TEMA=claro
